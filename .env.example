# Copy values into your hosting provider's Environment settings.
# For local development, you can also copy this file to .env and load it with a dotenv package.
PORT=3000
# IMPORTANT: set these two values before exposing the dashboard publicly.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# For Render with a persistent disk mounted at /var/data, use:
WWEBJS_AUTH_PATH=/var/data/whatsapp_sessions
